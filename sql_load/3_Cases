

CREATE TABLE january_jobs AS
    SELECT *
    FROM job_postings_fact
    WHERE EXTRACT(MONTH FROM job_posted_date) = 1;

CREATE TABLE february_jobs AS
    SELECT *
    FROM job_postings_fact
    WHERE EXTRACT(MONTH FROM job_posted_date) = 2;

CREATE TABLE march_jobs AS
    SELECT *
    FROM job_postings_fact
    WHERE EXTRACT(MONTH FROM job_posted_date) = 3;

WITH Skill_count AS
(
    SELECT a.skills,a.skill_id,COUNT(job_id)
    FROM skills_dim AS a
    JOIN skills_job_dim AS b ON a.skill_id = b.skill_id
    GROUP BY a.skill_id,skills
);
WITH 
SELECT *
FROM Skill_count

WITH Remote_jobs AS
(
    SELECT b.skill_id
    FROM job_postings_fact AS a
    JOIN skills_job_dim AS b ON a.job_id = b.job_id
    WHERE job_work_from_home IS TRUE
   -- GROUP BY b.skill_id
)
SELECT 
    s.skills
    ,COUNT(c.skill_id) AS CountSkills
FROM Remote_jobs c 
JOIN skills_dim s ON c.skill_id = s.skill_id
GROUP BY s.skills
ORDER BY CountSkills DESC
